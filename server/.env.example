# PayServer Go Backend Configuration
# Copy this file to .env and fill in your values

# Server Configuration
PAYSERVER_ADDR=:30911
PAYSERVER_DEBUG=false
PAYSERVER_HTTP_ALLOW_ORIGIN=*

# Database Configuration
# Supported formats:
# - MySQL: mysql://user:pass@localhost:3306/payserver
# - PostgreSQL: postgres://user:pass@localhost:5432/payserver?sslmode=disable
# - Supabase: supabase://postgres.xxx:[password]@aws-0-us-west-1.pooler.supabase.com:6543/postgres
PAYSERVER_DB=postgres://postgres:password@localhost:5432/payserver?sslmode=disable

# Service Configuration
PAYSERVER_NAME=PayServer
PAYSERVER_HOST=https://pay.example.com
PAYSERVER_VERSION=v1

# Pricing Configuration (in cents/fen)
PAYSERVER_PRICE_FLOOR=20
PAYSERVER_PRICE_CEIL=100000

# Order Configuration
PAYSERVER_EXPIRE_IN=300
PAYSERVER_MAX_PENDDING_ORDER=10
PAYSERVER_MAX_PENDDING_AGENT=5

# JWT Authentication
# Use the same secret as your Supabase JWT secret for compatibility
# Get from: https://supabase.com/dashboard/project/_/settings/api (JWT Secret)
PAYSERVER_JWT_SECRET=your-supabase-jwt-secret
# Or use your own secret for API key auth (min 32 chars)
PAYSERVER_API_SECRET=your-api-secret-min-32-chars
